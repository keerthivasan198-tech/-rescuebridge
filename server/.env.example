# ==============================================================
# RescueBridge Backend - Production Environment Variables Template
# Copy this file to .env and fill in your confidential production values.
# NEVER commit the real .env to git.
# ==============================================================

# Server Configuration
PORT=5001
NODE_ENV=development

# Allowed CORS Origins (comma separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database Configuration (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_or_anon_key

# Secret Webhook API Key for Google Forms Apps Script
FORM_WEBHOOK_API_KEY=your_random_32_char_secret_key_here

# Google Cloud Service Account Credentials (JSON string - optional fallback)
GOOGLE_SERVICE_ACCOUNT_KEY=

# Google OAuth 2.0 Credentials (1-Click Hospital Sheet Connection)
GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_REDIRECT_URI=https://rescuebridge-omega.vercel.app/

