# Base URL for your FastAPI / Node.js backend
VITE_API_BASE_URL=

# Google Review URL for your clinic (obtain from Google Business Profile)
VITE_GOOGLE_REVIEW_URL=

# Clinic display name shown across the app
VITE_CLINIC_NAME=ABC Healthcare

# ----------------------------------------------------------------
# The following keys are NEVER used in the frontend.
# They are listed here for documentation purposes only.
# Store them securely in your backend environment.
# ----------------------------------------------------------------
# WHATSAPP_API_TOKEN=
# SARVAM_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_BUSINESS_PROFILE_KEY=
